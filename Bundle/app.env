# App identity. Single source for scripts/, the Makefile and CI.
# Sourced by bash: quote values that contain spaces.

APP_NAME=SwiftUITemplate
APP_DISPLAY_NAME="SwiftUI Template"
BUNDLE_ID=io.chengzi.SwiftUITemplate
APP_CATEGORY=public.app-category.developer-tools
COPYRIGHT="Copyright © 2026 ChengZi"

# Developer ID team. Empty: ad-hoc signing, no notarization.
TEAM_ID=

# Sparkle updates (release builds). The public key is safe to commit; the private
# key stays in the keychain and the SPARKLE_ED_PRIVATE_KEY secret (make sparkle-keys).
SPARKLE_FEED_URL=https://github.com/chengzi-io/macos-swiftui-spm-template/releases/latest/download/appcast.xml
SPARKLE_PUBLIC_KEY=
