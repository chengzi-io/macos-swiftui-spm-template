// AppStore target: the Pomelo target's settings for the App Store build, which
// carries no Sparkle (the App Store updates the app). scripts/build-app.sh mas
// archives it and signs it for the App Store.

#include "App.xcconfig"

INFOPLIST_FILE = Configs/AppStore-Info.plist
CODE_SIGN_ENTITLEMENTS = Configs/AppStore.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = APP_STORE $(inherited)
