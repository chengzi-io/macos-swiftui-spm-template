// Pomelo, the app target. Identity comes from Identity.xcconfig through
// Project.xcconfig.

PRODUCT_NAME = $(APP_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID)
// Placeholders for Xcode builds; scripts/build-app.sh passes version.txt and the
// commit count.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1

INFOPLIST_FILE = Configs/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = $(APP_CATEGORY)
INFOPLIST_KEY_NSHumanReadableCopyright = $(COPYRIGHT)
INFOPLIST_KEY_NSPrincipalClass = NSApplication
CODE_SIGN_ENTITLEMENTS = Configs/App.entitlements

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
COMBINE_HIDPI_IMAGES = YES
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
